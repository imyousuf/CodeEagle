# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# The Go workspace file is committed, not ignored.
#
# pkg/jev is its own module and the application imports it, so without the
# workspace a fresh clone resolves that import through the module proxy --
# where it does not exist until a version is tagged. The usual advice to keep
# go.work out of version control is for libraries; this is an application
# repository whose own build depends on it.

# Build output
bin/
codeeagle
/backpop-paths
/facetest

# Frontend build artifacts
node_modules/
internal/app/frontend/dist/

# Graph database
.codeeagle/
.CodeEagle/

# env file
.env

# Editor/IDE
# .idea/
.vscode/
